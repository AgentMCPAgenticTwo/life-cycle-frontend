  "stories": [
    {
      "epic": "Tracker",
      "actor": "Tenant Admin, Contract Owner (Sales/Procurement), Legal Reviewer, Approver",
      "title": "Block unauthorized direct-link access to Tracker",
      "images": [
        "IMG-1"
      ],
      "story_id": "UC10-AF-002",
      "references": [
        "UC10",
        "AF-2",
        "BR-5",
        "BR-12",
        "DP-UC10-001",
        "DP-UC10-002",
        "DP-UC10-003",
        "DP-UC10-004",
        "DP-UC10-005",
        "DP-UC10-010",
        "DP-UC10-011",
        "DP-UC10-012",
        "DP-UC10-013",
        "DP-UC10-014",
        "DP-UC10-015",
        "DP-UC10-016",
        "DP-UC10-017",
        "DP-UC10-018",
        "DP-UC10-020"
      ],
      "story_type": "alternate-flow",
      "story_statement": "As a user without a permitted Tracker role, I want to be blocked from viewing the Tracker when I attempt direct-link access, so that contract reporting data visible via Period, Contract Type Filter, Owner Filter, Date Range From, Date Range To, Owner Name, Contracts Owned, Average Cycle Time, Current Stage, Days in Current Stage, Stuck Flag, Estimated Turnaround, Actual Turnaround, and Variance remains restricted to authorized roles only.",
      "source_reference": "UC10 / Alternate Flow / AF-2",
      "notes_assumptions": "DP-UC10-020 ('Change UC10 BR4 to') refers to a documented revision of BR-4; exact revised wording was not provided in this unit's context, so acceptance criterion 7 confirms the access-control behavior is unaffected by the pending BR-4 change rather than specifying its new text.",
      "acceptance_criteria": [
        "Given a user who is not a Tenant Admin, Contract Owner (Sales/Procurement), Legal Reviewer, or Approver, when they attempt to access the Tracker screen via a direct link, then the system displays the message 'You do not have permission to view this page.' and redirects the user to the Dashboard without rendering any Tracker content.",
        "Given the access attempt is blocked, then none of the Tracker's filter controls or data fields are exposed to the user, including Period, Contract Type Filter, Owner Filter, Date Range From, and Date Range To.",
        "Given the access attempt is blocked, then none of the Ownership tab data is exposed to the user, including Owner Name and Contracts Owned.",
        "Given the access attempt is blocked, then none of the Cycle Time tab data is exposed to the user, including Average Cycle Time.",
        "Given the access attempt is blocked, then none of the Bottleneck tab data is exposed to the user, including Current Stage, Days in Current Stage, and Stuck Flag.",
        "Given the access attempt is blocked, then none of the Turnaround tab data is exposed to the user, including Estimated Turnaround, Actual Turnaround, and Variance.",
        "Given BR-4 governs Estimated Turnaround Days behavior when no target completion date was set, when the business rule change referenced as 'Change UC10 BR4 to' is applied, then the updated rule is enforced consistently and does not alter the access-denial behavior defined in this alternate flow for unauthorized users."
      ]
    },
    {
      "epic": "Settings / Admin",
      "actor": "Tenant Admin",
      "title": "Block Unauthorized Access to Settings / Admin Screen",
      "images": [
        "IMG-2",
        "IMG-3",
        "IMG-4",
        "IMG-5",
        "IMG-6"
      ],
      "story_id": "UC11-AF-001",
      "references": [
        "UC11",
        "BR-1",
        "BR-12"
      ],
      "story_type": "alternate-flow",
      "story_statement": "As a Tenant Admin, I want non-Tenant-Admin users to be blocked from accessing the Settings / Admin screen, so that sensitive tenant configuration and audit data remain protected from unauthorized roles.",
      "source_reference": "UC11 / Alternate Flow / AF-1",
      "acceptance_criteria": [
        "Given a user who is not assigned the Tenant Admin role is logged in, When that user attempts to navigate directly to the Settings / Admin screen URL or clicks a Settings / Admin menu entry, Then the system blocks access and displays 'You do not have permission to view this page'.",
        "Given a non-Tenant-Admin user is viewing the application, When the main navigation renders, Then no Settings / Admin menu entry is shown to that user per BR-1 and BR-12.",
        "Given access to the Settings / Admin screen is blocked for a non-Tenant-Admin user, When the block is enforced, Then none of the following data groups are rendered or returned to that user: Contract Type [DP-UC11-003], Value Threshold [DP-UC11-004], Approver Role [DP-UC11-005], Integration Name [DP-UC11-008], Connection Status [DP-UC11-009], Event Name [DP-UC11-012], Email Toggle [DP-UC11-013], In-App Toggle [DP-UC11-014], Log Date/Time [DP-UC11-016], Log User [DP-UC11-017], Log Action [DP-UC11-018], Log Entity [DP-UC11-019], and Filter Date Range [DP-UC11-020].",
        "Given a user with any of the roles Legal Reviewer, Contract Owner, Approver, External Party, or Signer, When they attempt to access the Routing & Approval, Integrations, Notifications, or Audit Log tabs directly, Then access is denied and the same permission-denied message is displayed, regardless of tab."
      ]
    },
    {
      "epic": "Settings / Admin",
      "actor": "Tenant Admin",
      "title": "Restrict Settings/Admin screen access from non-Tenant-Admin roles",
      "images": [
        "IMG-2",
        "IMG-3",
        "IMG-4",
        "IMG-5",
        "IMG-6"
      ],
      "story_id": "UC11-BR-012",
      "references": [
        "UC11-BR-012",
        "DP-UC11-003",
        "DP-UC11-004",
        "DP-UC11-005",
        "DP-UC11-008",
        "DP-UC11-009",
        "DP-UC11-012",
        "DP-UC11-013",
        "DP-UC11-014",
        "DP-UC11-016",
        "DP-UC11-017",
        "DP-UC11-018",
        "DP-UC11-019",
        "DP-UC11-020"
      ],
      "story_type": "business-rule",
      "story_statement": "As a Tenant Admin, I want Legal Reviewer, Contract Owner, Approver, External Party and Signer roles to be blocked from the Settings / Admin screen, so that sensitive tenant configuration and data remain accessible only to authorized administrators.",
      "source_reference": "UC11 / Business Rules / BR-12",
      "acceptance_criteria": [
        "Given a user logged in with the Legal Reviewer, Contract Owner, Approver, External Party, or Signer role, When that user attempts to navigate to the Settings / Admin screen, Then access is denied and no Settings / Admin menu entry or screen content is rendered.",
        "Given a user in any of the restricted roles is denied access, When the system blocks navigation, Then none of the Routing & Approval Tab data points including Contract Type, Value Threshold, and Approver Role are exposed to that user.",
        "Given a user in any of the restricted roles is denied access, When the system blocks navigation, Then none of the Integrations Tab data points including Integration Name and Connection Status are exposed to that user.",
        "Given a user in any of the restricted roles is denied access, When the system blocks navigation, Then none of the Notifications Tab data points including Event Name, Email Toggle, and In-App Toggle are exposed to that user.",
        "Given a user in any of the restricted roles is denied access, When the system blocks navigation, Then none of the Audit Log Tab data points including Log Date/Time, Log User, Log Action, Log Entity, and Filter Date Range are exposed to that user.",
        "Given a Tenant Admin user, When that user navigates to the Settings / Admin screen, Then full access to all tabs and their associated data points (Contract Type, Value Threshold, Approver Role, Integration Name, Connection Status, Event Name, Email Toggle, In-App Toggle, Log Date/Time, Log User, Log Action, Log Entity, Filter Date Range) is granted as expected."
      ]
    }
  ]
}